# Copier ce fichier en .env (ignoré par Git), puis remplir les valeurs :
#   cp .env.example .env
# Lu par ingestion/charger_mois.py, test/test_connexion.py et snowflake/rendre.py.
# Une variable déjà définie dans le terminal reste prioritaire sur le .env.

# Identifiant de compte, format ORGANISATION-COMPTE : la seule valeur propre
# à ton compte. Pour le récupérer, dans Snowsight :
#   SELECT CURRENT_ORGANIZATION_NAME() || '-' || CURRENT_ACCOUNT_NAME();
SNOWFLAKE_ACCOUNT=

# Objets créés par snowflake/01_infrastructure.sql. Noms libres : ceux-ci sont
# les exemples donnés par CONTRAT_RAW.md, à adapter pour un autre projet.
SNOWFLAKE_ROLE=TRANSFORMER
SNOWFLAKE_WAREHOUSE=NYC_TAXI_WH
SNOWFLAKE_USER=AIRFLOW_SVC
SNOWFLAKE_RESOURCE_MONITOR=NYC_TAXI_RM
SNOWFLAKE_CREDIT_QUOTA=10

# Paire de clés de l'utilisateur de service : des CHEMINS, jamais le contenu,
# et jamais de fichier de clé dans le dépôt.
# Générer la paire :
#   mkdir -p ~/.ssh/snowflake && cd ~/.ssh/snowflake
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -inform PEM -out rsa_key.p8 -nocrypt
#   openssl rsa -in rsa_key.p8 -pubout -out rsa_key.pub && chmod 600 rsa_key.p8
# La clé publique est lue par snowflake/rendre.py et enregistrée sur
# l'utilisateur de service par 01_infrastructure.sql.
SNOWFLAKE_PRIVATE_KEY_PATH=~/.ssh/snowflake/rsa_key.p8
SNOWFLAKE_PUBLIC_KEY_PATH=~/.ssh/snowflake/rsa_key.pub

# Dossier des fichiers téléchargés par ingestion/charger_mois.py, hors du dépôt
DOSSIER_TELECHARGEMENT=/tmp/tlc
